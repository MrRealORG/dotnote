{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DotNote",
  "version": "1.0.0",
  "identifier": "com.dotnote.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DotNote",
        "url": "index.html",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Minimal mono notes with channels, voice & AI",
    "longDescription": "DotNote is a super minimal, fast, local-first notes app with Discord-style channels, Notion-style blocks, voice transcription, goals and AI — all in one quiet monochrome place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
